# Server configuration
PORT=5000
NODE_ENV=development

# Leave MONGODB_URI empty in development to use the embedded MongoDB.
# For production, provide a real MongoDB connection string:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/lovaction
MONGODB_URI=

# Use a long, random secret in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed client origins in production
CLIENT_URL=http://localhost:5173

# Seed a full demo community on first start (true/false)
SEED_DEMO_DATA=true
